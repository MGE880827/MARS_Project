# =============================================
# ⭐｜系統組態-A｜資料庫存取憑證
# =============================================
# [功能] 定義 PostgreSQL 核心資料庫之連線組態，確保底層實體寫入之安全對接。
DB_HOST = localhost
DB_PORT = 5432
DB_NAME = MARS_DB
DB_USERNAME = postgres
DB_PASSWORD = 880827

# =============================================
# ⭐｜系統組態-B｜開發環境配置
# =============================================
# [功能] 定義專案全域搜尋路徑，確保跨模組動態掛載與導入 (如 config 與 database) 之尋址正確性。
PYTHONPATH = .